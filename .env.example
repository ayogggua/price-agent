# 服务监听配置
HOST=127.0.0.1
PORT=4312
APP_BASE_PATH=
COOKIE_SECURE=false
TRUST_PROXY=0
APP_SECRET=replace_with_a_random_64_char_hex_secret

# MySQL 数据库配置（与 compose.yaml 默认映射保持一致）
DB_HOST=127.0.0.1
DB_PORT=3397
DB_NAME=price_agent
DB_USER=price_agent
DB_PASSWORD=replace_with_strong_db_password
DB_ROOT_PASSWORD=replace_with_strong_db_root_password

# AI 模型服务配置（兼容 OpenAI Chat Completions 接口协议，即 /chat/completions）
VERTEX_BASE_URL=https://your-llm-gateway.example.com/v1
VERTEX_API_KEY=replace_with_your_api_key
VERTEX_MODEL=gemini-2.5-flash

# 联网检索配置（默认使用公开搜索；可选配置 Tavily 或 Serper API Key 提升检索质量）
SEARCH_PROVIDER=bing
TAVILY_API_KEY=
SERPER_API_KEY=
