# 服务监听、品牌与安全配置
HOST=127.0.0.1
PORT=4312
APP_BASE_PATH=
APP_BRAND_NAME=报价工作台
DEFAULT_COMPANY_NAME=
# COOKIE_SECURE 可选 auto | true | false（auto 在 HTTPS 或反向代理 X-Forwarded-Proto=https 下自动启用 Secure）
COOKIE_SECURE=auto
TRUST_PROXY=0
APP_SECRET=replace_with_a_random_64_char_hex_secret
# 可选：自定义导出 PDF 的中文字体绝对路径（留空默认使用内置 server/assets/NotoSansCJKsc-Regular.otf）
PDF_FONT_PATH=

# MySQL 数据库配置（与 compose.yaml 默认映射端口 3397 保持一致）
DB_HOST=127.0.0.1
DB_PORT=3397
DB_NAME=price_agent
DB_USER=price_agent
DB_PASSWORD=replace_with_strong_db_password
DB_ROOT_PASSWORD=replace_with_strong_db_root_password

# AI 模型与 Vertex AI Gemini Proxy / OpenAI 兼容网关配置
# 说明：系统同时兼容 AI_BASE_URL / AI_API_KEY / AI_MODEL、VERTEX_BASE_URL / VERTEX_API_KEY / VERTEX_MODEL
# 以及 OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL（本地 Ollama / vLLM 等内网地址支持免密钥调用）。
# 为同时兼容 compose.production.yaml 容器变量映射，默认使用 VERTEX_* 键名，也可按需改用 AI_* 键名：
VERTEX_BASE_URL=https://your-llm-gateway.example.com/v1
VERTEX_API_KEY=replace_with_your_api_key
VERTEX_MODEL=gemini-3.8-flash
# AI_BASE_URL=https://your-llm-gateway.example.com/v1
# AI_API_KEY=replace_with_your_api_key
# AI_MODEL=gemini-3.8-flash

# 思考强度与原生联网工具默认策略（亦可在系统设置页与项目分析栏按次覆盖；兼容 AI_THINKING_LEVEL / AI_ENABLE_SEARCH / AI_ENABLE_URL_CONTEXT）
# 思考强度可选值：AUTO | MINIMAL | LOW | MEDIUM | HIGH | XHIGH | NONE
VERTEX_THINKING_LEVEL=AUTO
VERTEX_ENABLE_SEARCH=true
VERTEX_ENABLE_URL_CONTEXT=true
# 可选：单次请求输出 Token 上限（256-131072，留空由上游按模型上限自动分配）与超时毫秒数（默认 240000）
AI_MAX_TOKENS=
AI_TIMEOUT_MS=240000

# 外部网页检索配置（开启 VERTEX_ENABLE_SEARCH 时优先协同原生 Google Search Grounding；亦支持以下多源检索回退）
# SEARCH_PROVIDER 可选 auto | bing | tavily | serper | searxng | none
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPER_API_KEY=
SEARXNG_BASE_URL=
